    <!-- Doc: tips -->
    <string name="doc_tips_chain_title">━━ Command chaining ━━</string>
    <string name="doc_tips_chain">Commands are detected left-to-right. You can use the result of one command as input to the next by placing commands sequentially.</string>
    <string name="doc_tips_naming_title">━━ Module naming ━━</string>
    <string name="doc_tips_naming">The file name becomes the Python module name. Use only letters, digits and underscores — no spaces or dashes.</string>
    <string name="doc_tips_debug_title">━━ Debugging ━━</string>
    <string name="doc_tips_debug">If a command returns \"Error\", check Android logcat with tag Executor for the full Python traceback.</string>
    <string name="doc_tips_service_title">━━ Service must be running ━━</string>
    <string name="doc_tips_service">Commands only work when the Executor accessibility service is active. Enable it in Settings → Accessibility → Executor.</string>

